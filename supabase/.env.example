# Secrets for the local Supabase stack (`supabase start` reads supabase/.env).
# Copy to supabase/.env and fill in. Never commit supabase/.env.

# Gmail account that sends sign-up, password-reset and magic-link emails.
SMTP_USER=digitaltechdynamics@gmail.com
# 16-character App Password, not the normal Gmail password:
# Google Account → Security → 2-Step Verification (must be on) → App passwords.
SMTP_PASS=

# "Continue with Google": OAuth client of type "Web application" from
# Google Cloud Console → APIs & Services → Credentials.
# Authorised redirect URI: http://127.0.0.1:54321/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
