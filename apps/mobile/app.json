{
  "expo": {
    "name": "Goal4Me",
    "slug": "goal4me",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "goal4me",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D12",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.goal4me.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true
      }
    },
    "android": {
      "package": "com.goal4me.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.WRITE_WEIGHT",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.WRITE_ACTIVE_CALORIES_BURNED"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Goal4Me",
      "themeColor": "#0B0D12"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Goal4Me uses your photos so you can add progress pictures. They stay private to your account.",
          "cameraPermission": "Goal4Me uses the camera so you can take progress pictures. They stay private to your account.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "@sentry/react-native",
        {
          "organization": "goal4me",
          "project": "goal4me-app",
          "url": "https://sentry.io/"
        }
      ],
      "expo-localization",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Goal4Me only saves data to Apple Health when you allow it. It does not read your health data.",
          "NSHealthUpdateUsageDescription": "Goal4Me saves your weigh-ins and workouts to Apple Health when you turn this on in Profile.",
          "background": false
        }
      ],
      "react-native-health-connect",
      "expo-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
