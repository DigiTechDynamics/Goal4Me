# Copy to .env (never commit .env). Values for local development come from
# `supabase start`; production values live in EAS secrets and Supabase.

# --- App (public: bundled into the client, safe to expose) -------------------
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_VIDEO_CDN_URL=

# --- Server only (Supabase Edge Function secrets: `supabase secrets set`) ----
# NEVER prefix these with EXPO_PUBLIC_ — they must not reach the app bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret RevenueCat sends as "Authorization: Bearer <secret>" (set the
# same value in RevenueCat → Integrations → Webhooks).
REVENUECAT_WEBHOOK_SECRET=
# From the PayNow merchant dashboard → Integrations.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# https://<project>.supabase.co/functions/v1/paynow-result
PAYNOW_RESULT_URL=
# The web app's return page, e.g. https://app.goal4me.com/paynow/return
PAYNOW_RETURN_URL=
# Restricts CORS on Edge Functions, e.g. https://app.goal4me.com
APP_ORIGIN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=goal4me-videos
